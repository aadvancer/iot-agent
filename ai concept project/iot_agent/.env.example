# Copy this file to .env and fill in your own key. Never commit .env.
DEEPSEEK_API_KEY=your-api-key
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-v4-pro
# USER_SIM_MODEL=deepseek-flash
# JUDGE_MODEL=deepseek-flash
# Seconds to wait for one model request before giving up (retried once):
# LLM_TIMEOUT=120
# DeepSeek thinking mode: disabled (default, fast) | low | high | max | default (send nothing)
# LLM_THINKING=disabled
# Knowledge-base vector database (ChromaDB):
# KB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# VECTOR_DB_DIR=.cache/chroma
